# Optional settings - copy to .env and fill in what you use.

# LLM provider: ollama (default, local) | azure | none (retrieval only)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Azure OpenAI (used when LLM_PROVIDER=azure or embedding backend "azure")
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# MLflow (defaults to a local SQLite file, mlflow.db)
# MLFLOW_TRACKING_URI=databricks
